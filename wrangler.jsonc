{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pic-gs26-admin",
  "compatibility_date": "2026-07-21",
  // OpenNext runs the Next.js server on the Node.js-compat Workers runtime.
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Incremental cache (ISR/data cache) is optional and needs an R2 bucket:
  // create one, then add here and reference it from open-next.config.ts:
  //   "r2_buckets": [
  //     { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "maizube-erp-cache" }
  //   ]
}
