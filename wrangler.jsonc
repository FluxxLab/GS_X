{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gs-x",
  "compatibility_date": "2026-07-21",
  // The auth/token proxy. Plain fetch handler, no framework - see worker/index.ts.
  "main": "worker/index.ts",
  "assets": {
    // `next build` output (static export) plus out/_headers from scripts/write-headers.mjs.
    "directory": "out",
    "binding": "ASSETS",
    // Next exports /pitchathon as pitchathon.html; auto-trailing-slash maps
    // the clean URL onto it without a redirect.
    "html_handling": "auto-trailing-slash",
    // Next emits out/404.html; serve it for unknown paths instead of 404-ing blank.
    "not_found_handling": "404-page",
    // Only API calls run the Worker. Everything else is answered straight from
    // the asset store with no Worker invocation and no CPU accounting.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Runtime var for the Worker. The NEXT_PUBLIC_* origins are build-time
    // (inlined into the static bundle by `next build`), so they live in the
    // build environment, not here.
    "API_BASE_URL": "https://18-175-94-245.sslip.io/api/v1"
  }
}
